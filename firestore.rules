rules_version = '2';

// Quote Console — server-side access control.
//
// Everything the browser can reach is gated here. The client is untrusted: an
// advisor who edits the JavaScript still cannot read another advisor's quotes,
// because this file runs on Google's servers, not in the browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    // An account only counts as a console user once an admin has created its
    // profile document and left it active. No profile means no access at all.
    function isActiveUser() {
      return hasProfile() && profile().active == true;
    }

    function isAdmin() {
      return isActiveUser() && profile().role == 'admin';
    }

    // Profiles are created and edited in the Firebase console by an admin.
    // Nothing in the app writes here, so nobody can promote themselves.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /quotes/{quoteId} {

      allow read: if isAdmin()
                  || (isActiveUser() && resource.data.advisorUid == request.auth.uid);

      // A quote can only be created in the creator's own name, and the fields
      // the reports depend on have to be the right shape.
      allow create: if isActiveUser()
                    && request.resource.data.advisorUid == request.auth.uid
                    && request.resource.data.totalValue is number
                    && request.resource.data.totalValue >= 0
                    && request.resource.data.issueMonth is string
                    && request.resource.data.dateIssued is string
                    && request.resource.data.outcome in ['pending', 'closed', 'lost'];

      // Advisors may update their own quotes, but may not hand one to somebody
      // else or move it into a different month. That keeps a closed month from
      // quietly changing after it has been reported on.
      allow update: if (isAdmin() || (isActiveUser() && resource.data.advisorUid == request.auth.uid))
                    && request.resource.data.advisorUid == resource.data.advisorUid
                    && request.resource.data.issueMonth == resource.data.issueMonth
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.totalValue is number
                    && request.resource.data.totalValue >= 0
                    && request.resource.data.outcome in ['pending', 'closed', 'lost'];

      // Deleting loses history, so it stays with admins.
      allow delete: if isAdmin();
    }
  }
}
